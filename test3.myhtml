<MYHTML>
  <head>
    <title>"Example Page"</title>
    <meta name="23" content="d" >
    <meta charset="UTF-8" >
  </head>
  <body>
    <div style="lightgray" id="main">
      <p id="intro">Welcome to our website!</p>
      <a href="/label/index.html" id="qq">Click here to visit</a>
      <img  id="ela" src="/image.jpg" alt="Example Image"  height=200  />
      <form id="contactForm" style="font-size: 12px;">
        <label for="emailInput" id="emailLabel"  style="color: blue;">Email</label>
        <input type="text" id="emailInput" value="user@example.com" />
        <input type="submit" id="submitBtn" value="Submit" />
      </form>
    </div>
  </body>
</MYHTML>